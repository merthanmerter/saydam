# ─── Zorunlu ──────────────────────────────────────────────────────────────────
# Neon connection string (pooler uç noktası önerilir)
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/saydam?sslmode=require"
# Oturum çerezlerini imzalamak için rastgele değer: openssl rand -base64 32
SESSION_SECRET=""

# Vercel/Neon entegrasyonu DATABASE_URL yerine POSTGRES_URL da verebilir;
# ikisinden hangisi doluysa o kullanılır.

# ─── Uygulama ─────────────────────────────────────────────────────────────────
# Davet bağlantıları ve ödeme dönüşleri için mutlak adres.
# Vercel'de boş bırakılırsa VERCEL_PROJECT_PRODUCTION_URL kullanılır.
APP_URL="http://localhost:3000"
# true → bulut (SaaS) sürümü: abonelik ve platform ücreti aktif olur
SAAS_MODE="false"

# ─── E-posta (davet / şifre sıfırlama) ────────────────────────────────────────
# Tanımlı değilse davet bağlantısı yönetim ekranında gösterilir, mail gitmez.
RESEND_API_KEY=""
MAIL_FROM="say-dam <bildirim@ornek.com>"

# ─── Dosya yükleme (fatura, dekont, doküman) ──────────────────────────────────
# Vercel Blob mağazası bağlandığında otomatik gelir.
BLOB_READ_WRITE_TOKEN=""

# ─── Platform aboneliği tahsilatı (yalnızca bulut sürümü) ─────────────────────
# Bunlar PLATFORMUN kendi PayTR hesabıdır ve sadece abonelik ücretini tahsil
# etmek için kullanılır. Sitelerin aidat tahsilatı buradan GEÇMEZ; her site
# kendi iyzico ya da PayTR anahtarlarını portaldeki Ayarlar ekranından girer.
PLATFORM_PAYTR_MERCHANT_ID=""
PLATFORM_PAYTR_MERCHANT_KEY=""
PLATFORM_PAYTR_MERCHANT_SALT=""
# "false" yapılana kadar test modunda çalışır.
PLATFORM_PAYTR_SANDBOX="true"

# ─── Zamanlanmış işler ────────────────────────────────────────────────────────
# Otomatik tahakkuk için. Vercel Cron bu değeri "Authorization: Bearer …"
# başlığıyla gönderir; tanımlı değilse /api/cron/* uçları hiç çalışmaz.
CRON_SECRET=""

# ─── Sır şifreleme ────────────────────────────────────────────────────────────
# Sitelerin iyzico anahtarları veritabanına AES-256-GCM ile şifrelenerek yazılır.
# Boş bırakılırsa SESSION_SECRET kullanılır; o durumda SESSION_SECRET'i
# değiştirmek kayıtlı ödeme anahtarlarını çözülemez hâle getirir.
SECRETS_KEY=""

# ─── İsteğe bağlı ayarlar ─────────────────────────────────────────────────────
# Kendi sunucunuzda çalıştırırken dinlenecek port (varsayılan 3000).
# PORT="3000"
# Veritabanı bağlantı havuzu üst sınırı. Sunucusuz ortamda örnek başına
# bağlantı açıldığı için düşük tutulur (üretimde 4, geliştirmede 10).
# DB_POOL_MAX="4"
# `bun run shots` ekran görüntülerini hangi adresten çeksin (varsayılan
# http://localhost:3000). Yalnızca geliştirmede kullanılır.
# SHOTS_BASE_URL="http://localhost:3000"
